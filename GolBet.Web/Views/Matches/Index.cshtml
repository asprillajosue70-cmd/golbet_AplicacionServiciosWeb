
@using GolBet.Entities.Enums
@using GolBet.Web.Helpers
@model IEnumerable<GolBet.Services.DTOs.MatchDto>

@{
    ViewData["Title"] = "Partidos";
    var current = (MatchStatus?)ViewBag.CurrentStatus;
}

<div class="d-flex gap-2 flex-wrap mb-4">
    <a asp-action="Index"
       asp-route-search="@ViewBag.CurrentSearch"
       class="match-status-filter btn btn-sm @(current is null ? "btn-success" : "btn-outline-success")">
        Todos
    </a>

    <a asp-action="Index"
       asp-route-status="@MatchStatus.Scheduled"
       asp-route-search="@ViewBag.CurrentSearch"
       class="match-status-filter btn btn-sm @(current == MatchStatus.Scheduled ? "btn-success" : "btn-outline-success")">
        Programados
    </a>

    <a asp-action="Index"
       asp-route-status="@MatchStatus.InProgress"
       asp-route-search="@ViewBag.CurrentSearch"
       class="match-status-filter btn btn-sm @(current == MatchStatus.InProgress ? "btn-success" : "btn-outline-success")">
        En juego
    </a>

    <a asp-action="Index"
       asp-route-status="@MatchStatus.Finished"
       asp-route-search="@ViewBag.CurrentSearch"
       class="match-status-filter btn btn-sm @(current == MatchStatus.Finished ? "btn-success" : "btn-outline-success")">
        Finalizados
    </a>
</div>

<form asp-action="Index"
      method="get"
      id="matchSearchForm"
      class="mb-4">

    <input type="hidden" name="status" value="@current" />

    <label for="matchSearch" class="form-label">
        Buscar partidos por equipo
    </label>

    <div class="input-group">
        <span class="input-group-text">
            <i class="bi bi-search"></i>
        </span>

        <input type="search"
               id="matchSearch"
               name="search"
               class="form-control"
               placeholder="Ej. Atlético Nacional..."
               value="@ViewBag.CurrentSearch"
               autocomplete="off" />

        <button type="submit" class="btn btn-success">
            Buscar
        </button>
    </div>
</form>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Cartelera de partidos</h2>

    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Create" class="btn btn-success">+ Nuevo partido</a>
    }
</div>

<div id="matchResults">
    @await Html.PartialAsync("_MatchCards", Model)
</div>

@section Scripts {
    <script>
        const searchInput = document.getElementById("matchSearch");
        const searchForm = document.getElementById("matchSearchForm");
        const resultsContainer = document.getElementById("matchResults");

        let searchTimeout;
        let activeRequestController;

        function updateStatusFilterLinks() {
            const search = searchInput.value.trim();

            document.querySelectorAll(".match-status-filter").forEach(link => {
                const url = new URL(link.href);

                if (search) {
                    url.searchParams.set("search", search);
                } else {
                    url.searchParams.delete("search");
                }

                link.href = url.toString();
            });
        }

        async function searchMatches() {
            clearTimeout(searchTimeout);

            if (activeRequestController) {
                activeRequestController.abort();
            }

            const controller = new AbortController();
            activeRequestController = controller;

            const params = new URLSearchParams(
                new FormData(searchForm)
            );

            const url = new URL(
                searchForm.action,
                window.location.origin
            );

            url.search = params.toString();

            try {
                const response = await fetch(url, {
                    headers: {
                        "X-Requested-With": "XMLHttpRequest"
                    },
                    signal: controller.signal
                });

                if (!response.ok) {
                    throw new Error("No se pudieron cargar los partidos.");
                }

                const html = await response.text();

                if (activeRequestController !== controller) {
                    return;
                }

                resultsContainer.innerHTML = html;

                window.history.replaceState(null, "", url);

                updateStatusFilterLinks();
            }
            catch (error) {
                if (error.name !== "AbortError") {
                    console.error(error);
                }
            }
        }

        searchInput.addEventListener("input", function () {
            updateStatusFilterLinks();

            clearTimeout(searchTimeout);

            searchTimeout = setTimeout(function () {
                searchMatches();
            }, 300);
        });

        searchForm.addEventListener("submit", function (event) {
            event.preventDefault();
            searchMatches();
        });

        updateStatusFilterLinks();
    </script>
}
