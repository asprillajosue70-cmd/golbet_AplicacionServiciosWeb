
@using GolBet.Entities.Enums
@using GolBet.Web.Helpers
@model IEnumerable<GolBet.Services.DTOs.MatchDto>

@if (!Model.Any())
{
    <div class="text-center py-5">
        <i class="bi bi-search display-4 text-muted"></i>

        <h4 class="mt-3">No se encontraron partidos</h4>

        @if (!string.IsNullOrWhiteSpace(ViewBag.CurrentSearch as string))
        {
            <p class="text-muted">
                No se encontraron partidos con
                "@ViewBag.CurrentSearch".
            </p>
        }
        else
        {
            <p class="text-muted">
                No hay partidos disponibles para este filtro.
            </p>
        }

        <a asp-controller="Home"
           asp-action="Index"
           class="btn btn-success mt-2">
            <i class="bi bi-house-door"></i>
            Volver al inicio
        </a>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
        @foreach (var match in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <small class="text-muted">
                            @match.Date.ToColombiaTime().ToString("ddd dd MMM · h:mm tt")
                        </small>

                        @switch (match.Status)
                        {
                            case MatchStatus.Scheduled:
                                <span class="badge bg-primary">Programado</span>
                                break;

                            case MatchStatus.InProgress:
                                <span class="badge bg-warning text-dark">En juego</span>
                                break;

                            case MatchStatus.Finished:
                                <span class="badge bg-secondary">Finalizado</span>
                                break;
                        }
                    </div>

                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center text-center">
                            <div class="w-100">
                                <img src="@(match.HomeTeamCrestUrl ??
                                     "https://placehold.co/60x60/e9ecef/6c757d?text=FC")"
                                     alt="@match.HomeTeamName"
                                     width="60"
                                     height="60"
                                     class="mb-1" />

                                <div class="fw-bold small">
                                    @match.HomeTeamName
                                </div>
                            </div>

                            <div class="px-3 text-nowrap">
                                @if (match.Status == MatchStatus.Finished)
                                {
                                    <span class="fs-3 fw-bold">
                                        @match.HomeGoals - @match.AwayGoals
                                    </span>
                                }
                                else
                                {
                                    <span class="fs-4 text-muted">vs</span>
                                }
                            </div>

                            <div class="w-100">
                                <img src="@(match.AwayTeamCrestUrl ??
                                     "https://placehold.co/60x60?text= ")"
                                     alt="@match.AwayTeamName"
                                     width="60"
                                     height="60"
                                     class="mb-1" />

                                <div class="fw-bold small">
                                    @match.AwayTeamName
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card-footer">
                        <div class="row g-2 text-center">
                            <div class="col">
                                <div class="border rounded py-1">
                                    <small class="text-muted d-block">1 · Local</small>
                                    <span class="fw-bold">
                                        @match.HomeOdds.ToString("0.00")
                                    </span>
                                </div>
                            </div>

                            <div class="col">
                                <div class="border rounded py-1">
                                    <small class="text-muted d-block">X · Empate</small>
                                    <span class="fw-bold">
                                        @match.DrawOdds.ToString("0.00")
                                    </span>
                                </div>
                            </div>

                            <div class="col">
                                <div class="border rounded py-1">
                                    <small class="text-muted d-block">2 · Visitante</small>
                                    <span class="fw-bold">
                                        @match.AwayOdds.ToString("0.00")
                                    </span>
                                </div>
                            </div>
                        </div>

                        <a asp-action="Detail"
                           asp-route-id="@match.Id"
                           class="btn btn-sm btn-outline-secondary w-100 mt-2">
                            Ver detalle
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}

